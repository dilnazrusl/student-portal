# Скопируй в secrets.toml (локально) или вставь в раздел Secrets на Streamlit Cloud.
# secrets.toml НЕЛЬЗЯ загружать на GitHub — он в .gitignore.

# ---- база данных (Neon) ----
DB_HOST = "ep-xxxxxxxx-pooler.c-6.us-east-2.aws.neon.tech"
DB_PORT = 5432
DB_NAME = "neondb"
DB_USER = "neondb_owner"
DB_PASSWORD = "ВСТАВЬ_НОВЫЙ_ПАРОЛЬ_ИЗ_NEON"
DB_SSLMODE = "require"

# ---- файлы: по умолчанию лежат прямо в Neon, больше ничего не нужно ----
# Чтобы перейти на настоящее объектное хранилище (Cloudflare R2 / Backblaze B2 / Supabase / AWS S3),
# раскомментируй и заполни строки ниже. Новые файлы пойдут в облако, старые останутся в базе и
# продолжат открываться.
# STORAGE_BACKEND = "s3"
# S3_BUCKET = "student-portal-files"
# S3_ENDPOINT = "https://<id>.r2.cloudflarestorage.com"
# S3_KEY_ID = "..."
# S3_SECRET = "..."
# S3_REGION = "auto"
